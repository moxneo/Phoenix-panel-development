    "name": "Odoo (External DB)",
    "author": "Mox Neo",
    "description": "Odoo (16/17/18) with external PostgreSQL support. Generates odoo.conf on boot, supports optional Git-based custom addons, and is proxy-friendly for Cloudflare/Tailscale setups.",
    "features": [],
    "docker_images": {
        "ODOO": "ghcr.io/scriptjunkiedev/ptero-odoo:odoo-16-sha-d42b22c2baeced2fb33366fa2d1c8c8bb86c3b82"
    },
    "file_denylist": [],
    "startup": "bash /home/container/start.sh",
    "config": {
        "files": "{}",
        "startup": "{\r\n    \"done\": \"Odoo\"\r\n}",
        "logs": "{}",
        "stop": "^C"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\r\nset -euo pipefail\r\n\r\necho \"[INSTALL] Installing Odoo egg files (no OS package installs here).\"\r\necho \"[INSTALL] NOTE: Your server Docker image MUST already include the 'odoo' binary.\"\r\n\r\ncd /mnt/server\r\n\r\n# Persistent dirs (map to /home/container at runtime)\r\nmkdir -p data addons logs\r\n\r\necho \"[INSTALL] Writing /mnt/server/start.sh ...\"\r\ncat > /mnt/server/start.sh <<'EOF'\r\n#!/bin/sh\r\nset -eu\r\n\r\ncd /home/container\r\n\r\n# Ensure persistent folders exist\r\nmkdir -p data addons logs\r\n\r\necho \"[Odoo] Starting...\"\r\necho \"[Odoo] DB_HOST=${DB_HOST:-} DB_PORT=${DB_PORT:-} DB_USER=${DB_USER:-} DBFILTER=${ODOO_DB_FILTER:-}\"\r\n\r\nexec odoo --config /home/container/odoo.conf\r\nEOF\r\nchmod +x /mnt/server/start.sh\r\n\r\n# Write config template (env-substituted at install time)\r\n# If you want runtime-dynamic values, generate this file in start.sh instead.\r\necho \"[INSTALL] Writing /mnt/server/odoo.conf ...\"\r\ncat > /mnt/server/odoo.conf <<CFG\r\n[options]\r\nadmin_passwd = ${ODOO_ADMIN_PASSWD}\r\nhttp_port = 8069\r\nxmlrpc_interface = 0.0.0.0\r\nproxy_mode = ${ODOO_PROXY_MODE}\r\nlog_level = ${ODOO_LOG_LEVEL}\r\n\r\ndb_host = ${DB_HOST}\r\ndb_port = ${DB_PORT}\r\ndb_user = ${DB_USER}\r\ndb_password = ${DB_PASSWORD}\r\ndbfilter = ${ODOO_DB_FILTER:-.*}\r\n\r\ndata_dir = /home/container/data\r\naddons_path = /usr/lib/python3/dist-packages/odoo/addons,/home/container/addons\r\n\r\nlogfile = /home/container/logs/odoo.log\r\nCFG\r\n\r\necho \"[INSTALL] Done.\"",
            "container": "debian:12-slim",
            "entrypoint": "sh"
        }
    },
